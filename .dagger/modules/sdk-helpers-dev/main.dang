"""Development module for sdk-helpers"""
type SdkHelpersDev {
  """A module source of "." is the default, so it is not written to dagger-module.toml."""
  omitsDefaultModuleSource: Void @check {
    self.assertNoModuleSource(
      sdkHelpers.moduleManifest()
        .withName("check")
        .withLegacyPythonRuntime(moduleSource: ".", engineVersion: "v0.20.3")
        .generate(self.workspace)
        .file("dagger-module.toml")
        .contents,
    )
  }

  """A manifest loaded without a module source does not gain one when written back."""
  keepsLoadedModuleSourceUnset: Void @check {
    let loaded = sdkHelpers.moduleManifest(
      loadToml: Dagger.file(
        "dagger-module.toml",
        "name = \"check\"\nengineVersion = \"v0.20.3\"\n\n[runtime]\n  source = \"python\"\n",
      ),
    )
    self.assertNoModuleSource(loaded.generate(self.workspace).file("dagger-module.toml").contents)
    let regenerated = loaded.withLegacyGoRuntime.generate(self.workspace, legacyJson: true)
    self.assertNoModuleSource(regenerated.file("dagger-module.toml").contents)
    self.assertAbsent(regenerated.file("dagger.json").contents, "\"source\": \".\"")
  }

  """Loaded JSON pins are optional output. Other dependency settings remain intact."""
  controlsLoadedJSONPins: Void @check {
    let loaded = sdkHelpers.moduleManifest(loadJson: Dagger.file("dagger.json",
      "{\"name\":\"check\",\"engineVersion\":\"v0.20.3\"," +
        "\"sdk\":{\"source\":\"example.invalid/runtime@v1\",\"pin\":\"runtime-pin\",\"config\":{\"keep\":true}}," +
        "\"blueprint\":{\"source\":\"example.invalid/blueprint\",\"pin\":\"blueprint-pin\"}," +
        "\"toolchains\":[{\"source\":\"example.invalid/tools\",\"pin\":\"tools-pin\"}]," +
        "\"dependencies\":[{\"name\":\"dep\",\"source\":\"example.invalid/dep@v1\",\"pin\":\"dep-pin\",\"ignoreChecks\":[\"slow\"]}]}"))
    let unlocked = loaded.generate(self.workspace)
    self.assertNoPins(unlocked)
    self.assertContains(unlocked.file("dagger.json").contents, "\"ignoreChecks\"")
    self.assertContains(unlocked.file("dagger.json").contents, "\"keep\": true")
    self.assertContains(unlocked.file("dagger-module.toml").contents, "example.invalid/dep@v1")
    let locked = loaded.generate(self.workspace, lock: true)
    ["runtime-pin", "dep-pin"].each { pin =>
      self.assertContains(locked.file("dagger-module.toml").contents, "pin = " + JSON.encode(pin))
    }
    ["runtime-pin", "dep-pin", "blueprint-pin", "tools-pin"].each { pin =>
      self.assertContains(locked.file("dagger.json").contents, "\"pin\": " + JSON.encode(pin))
    }
    self.assertNoPins(loaded.generate(self.workspace))
  }

  """Loaded TOML pins are retained for locked output, including when JSON is also loaded."""
  controlsLoadedTOMLPins: Void @check {
    let loaded = sdkHelpers.moduleManifest(
      loadJson: Dagger.file("dagger.json", "{\"name\":\"old\",\"engineVersion\":\"v0.20.3\",\"sdk\":\"go\",\"dependencies\":[{\"source\":\"example.invalid/stale\",\"pin\":\"stale-pin\"}]}"),
      loadToml: Dagger.file("dagger-module.toml",
        "name = \"check\"\nengineVersion = \"v0.20.3\"\n[runtime]\nsource = \"go\"\npin = \"runtime-pin\"\n" +
          "[[dependencies]]\nname = \"dep\"\nsource = \"example.invalid/dep@v1\"\npin = \"dep-pin\"\n"),
    )
    self.assertNoPins(loaded.generate(self.workspace))
    let locked = loaded.generate(self.workspace, lock: true)
    self.assertContains(locked.file("dagger-module.toml").contents, "pin = \"runtime-pin\"")
    self.assertContains(locked.file("dagger-module.toml").contents, "pin = \"dep-pin\"")
    self.assertContains(locked.file("dagger.json").contents, "\"pin\": \"dep-pin\"")
    self.assertAbsent(locked.file("dagger.json").contents, "stale")
  }

  """Generation preserves loaded sources without resolving missing pins."""
  skipsPinLookup: Void @check {
    ["example.invalid/dep@v1", "example.invalid/bare", "deps/lib@v1.2",
      "@scope/lib", "deps/lib:dev", "../local"].each { source =>
      let encoded = JSON.encode(source)
      let json = sdkHelpers.moduleManifest(loadJson: Dagger.file("dagger.json",
        "{\"name\":\"check\",\"engineVersion\":\"v0.20.3\",\"sdk\":" + encoded +
          ",\"dependencies\":[{\"source\":" + encoded + "}],\"blueprint\":{\"source\":" + encoded +
          "},\"toolchains\":[{\"source\":" + encoded + "}]}"))
      let toml = sdkHelpers.moduleManifest(loadToml: Dagger.file("dagger-module.toml",
        "name = \"check\"\nengineVersion = \"v0.20.3\"\n[runtime]\nsource = " + encoded +
          "\n[[dependencies]]\nsource = " + encoded + "\n"))
      [json, toml].each { manifest =>
        [manifest.generate(self.workspace), manifest.generate(self.workspace, lock: true)].each { output =>
          self.assertNoPins(output)
          self.assertContains(output.file("dagger-module.toml").contents, "source = " + encoded)
          self.assertContains(output.file("dagger.json").contents, "\"source\": " + encoded)
        }
      }
    }
    null
  }

  """Local module paths are relative to each output manifest directory."""
  placesLocalDependencies: Void @check {
    let directory = Dagger.directory
      .withNewFile("deps/lib@v1.2/dagger.json", "{\"name\":\"lib\",\"engineVersion\":\"v1.0.0\",\"sdk\":\"dang\"}")
      .withNewFile("deps/lib@v1.2/main.dang", "type Lib { hello: String! { \"hello\" } }")
      .withNewFile("app/keep.txt", "keep")
    let manifest = sdkHelpers.moduleManifest().withName("check").withLegacyGoRuntime
      .withLegacyRuntimeDependency(directory.asModuleSource(sourceRootPath: "deps/lib@v1.2"))
    let workspace = directory.asWorkspace.withWorkdir("app")
    let output = manifest.generate(workspace, lock: true)
    self.assertNoPins(output)
    self.assertContains(output.file("dagger-module.toml").contents, "source = \"../deps/lib@v1.2\"")
    self.assertContains(output.file("dagger.json").contents, "\"source\": \"../deps/lib@v1.2\"")
    self.assertContains(output.file("dagger.json").contents, "\"name\": \"lib\"")
    if (output.cwd != workspace.cwd or output.file("keep.txt").contents != "keep") {
      raise "generation must preserve the workspace directory and other files"
    }
    if (workspace.directory(".").exists("dagger-module.toml")) {
      raise "generation must preserve the input workspace"
    }
    self.assertContains(manifest.generate(directory.asWorkspace).file("dagger-module.toml").contents,
      "source = \"deps/lib@v1.2\"")
    self.assertAbsent(manifest.withoutLegacyRuntimeDependency("lib")
      .generate(workspace).file("dagger-module.toml").contents, "[[dependencies]]")
  }

  """Replacing a dependency updates its source and pin without adding a duplicate."""
  replacesDependency: Void @check {
    let directory = Dagger.directory
      .withNewFile("deps/lib/dagger.json", "{\"name\":\"lib\",\"engineVersion\":\"v0.21.9\",\"sdk\":\"dang\"}")
      .withNewFile("deps/lib/main.dang", "type Lib { hello: String! { \"hello\" } }")
      .withNewFile("app/keep.txt", "keep")
    let module = directory.asModuleSource(sourceRootPath: "deps/lib")
    let ws = directory.asWorkspace.withWorkdir("app")
    let original = sdkHelpers.moduleManifest(loadJson: Dagger.file("dagger.json",
      "{\"name\":\"check\",\"engineVersion\":\"v0.21.9\",\"sdk\":\"go\",\"dependencies\":[" +
        "{\"name\":\"lib\",\"source\":\"example.invalid/old\",\"pin\":\"old-pin\"}," +
        "{\"name\":\"keep\",\"source\":\"../keep\"}]}"))
    let replaced = original.withLegacyRuntimeDependency(module).withLegacyRuntimeDependency(module)
    let output = replaced.generate(ws, lock: true)
    let json = Dagger.json.withContents(output.file("dagger.json").contents :: Dagger.JSON!)
    if (json.field(["dependencies"]).asArray.{{contents}}.length != 2) {
      raise "replacement must preserve the other dependency without adding a duplicate"
    }
    self.assertContains(output.file("dagger.json").contents, "\"source\": \"../deps/lib\"")
    self.assertContains(output.file("dagger-module.toml").contents, "source = \"../deps/lib\"")
    self.assertContains(output.file("dagger-module.toml").contents, "source = \"../keep\"")
    self.assertAbsent(output.file("dagger-module.toml").contents, "example.invalid/old")
    self.assertNoPins(output)
    self.assertContains(original.generate(ws, lock: true).file("dagger.json").contents, "old-pin")
  }

  """A manifest loaded from a workspace keeps the fields the caller does not set."""
  keepsWorkspaceManifestFields: Void @check {
    let toml = self.workspace.withNewFile("dagger-module.toml",
      "name = \"old\"\nengineVersion = \"v0.20.3\"\ninclude = [\"../go.mod\"]\nsource = \"src\"\n\n" +
        "[runtime]\n  source = \"go\"\n\n[codegen]\n  automaticGitignore = false\n")
    let fromTOML = sdkHelpers.loadModuleManifest(toml).withName("check").withLegacyGoRuntime
      .generate(toml).file("dagger-module.toml").contents
    ["name = \"check\"", "engineVersion = \"v0.20.3\"", "include = [\"../go.mod\"]", "source = \"src\"",
      "automaticGitignore = false"].each { expected => self.assertContains(fromTOML, expected) }
    let json = self.workspace.withNewFile("dagger.json",
      "{\"name\":\"old\",\"engineVersion\":\"v0.20.3\",\"sdk\":\"go\",\"include\":[\"../go.mod\"],\"source\":\"src\"}")
    let fromJSON = sdkHelpers.loadModuleManifest(json).withName("check").withLegacyGoRuntime.generate(json)
    self.assertContains(fromJSON.file("dagger-module.toml").contents, "source = \"src\"")
    self.assertContains(fromJSON.file("dagger.json").contents, "\"../go.mod\"")
    let fresh = sdkHelpers.loadModuleManifest(self.workspace).withName("check").withLegacyGoRuntime
      .generate(self.workspace).file("dagger-module.toml").contents
    self.assertAbsent(fresh, "v0.20.3")
    self.assertAbsent(fresh, "include")
  }

  """A module reuses the loaded dependency with the same source instead of adding a duplicate."""
  reusesDependencyWithSameSource: Void @check {
    let directory = Dagger.directory
      .withNewFile("deps/lib/dagger.json", "{\"name\":\"lib\",\"engineVersion\":\"v0.21.9\",\"sdk\":\"dang\"}")
      .withNewFile("deps/lib/main.dang", "type Lib { hello: String! { \"hello\" } }")
      .withNewFile("app/dagger-module.toml",
        "name = \"app\"\nengineVersion = \"v0.21.9\"\n\n[runtime]\n  source = \"go\"\n\n" +
          "[[dependencies]]\n  name = \"alias\"\n  source = \"../deps/lib\"\n\n" +
          "[[dependencies]]\n  name = \"stale\"\n  source = \"../stale\"\n")
    let ws = directory.asWorkspace.withWorkdir("app")
    let module = directory.asModuleSource(sourceRootPath: "deps/lib")
    let complete = sdkHelpers.loadModuleManifest(ws).withLegacyRuntimeDependencies(modules: [module])
      .generate(ws).file("dagger-module.toml").contents
    self.assertContains(complete, "name = \"alias\"")
    self.assertContains(complete, "source = \"../deps/lib\"")
    self.assertAbsent(complete, "name = \"lib\"")
    self.assertAbsent(complete, "stale")
    let added = sdkHelpers.loadModuleManifest(ws).withLegacyRuntimeDependency(module)
      .generate(ws).file("dagger-module.toml").contents
    self.assertContains(added, "name = \"alias\"")
    self.assertContains(added, "name = \"stale\"")
    self.assertAbsent(added, "name = \"lib\"")
  }

  """Absolute local paths are rejected when JSON or TOML is loaded."""
  rejectsAbsoluteDependencyPaths: Void @check {
    ["/tmp/dep", "C:/dep", "C:\\dep", "\\\\server\\dep"].each { source =>
      let jsonError = sdkHelpers.moduleManifest(loadJson: Dagger.file("dagger.json",
        "{\"dependencies\":[{\"source\":" + JSON.encode(source) + "}]}"))
        .withName("check").withLegacyGoRuntime.generate(self.workspace).file("dagger.json").contents rescue {
          error: Error => error.message
        }
      self.assertContains(jsonError, "local dependency source must be relative")
      let tomlError = sdkHelpers.moduleManifest(loadToml: Dagger.file("dagger-module.toml",
        "[[dependencies]]\nsource = " + JSON.encode(source) + "\n"))
        .withName("check").withLegacyGoRuntime.generate(self.workspace).file("dagger-module.toml").contents rescue {
          error: Error => error.message
        }
      self.assertContains(tomlError, "local dependency source must be relative")
    }
    null
  }

  """JSON output can be disabled without leaving an old manifest in the output workspace."""
  controlsLegacyJSONOutput: Void @check {
    let workspace = self.workspace.withNewFile("dagger.json", "old")
    let manifest = sdkHelpers.moduleManifest().withName("check").withLegacyGoRuntime
    let output = manifest.generate(workspace, legacyJson: false)
    if (output.directory(".").exists("dagger.json") or !output.directory(".").exists("dagger-module.toml")) {
      raise "JSON disabled must leave only the TOML manifest"
    }
    if (workspace.file("dagger.json").contents != "old" or output.file("keep.txt").contents != "keep") {
      raise "generation must preserve the input workspace and other files"
    }
    let entrypointOnly = manifest.withoutLegacyFields.withDangEntrypoint("main.dang").generate(workspace)
    if (entrypointOnly.directory(".").exists("dagger.json")) {
      raise "a manifest without legacy fields must not generate dagger.json"
    }
    null
  }

  """A supplied Git module keeps its source and selected commit."""
  honorsSuppliedGitModule: Void @check {
    let module = Dagger.moduleSource("github.com/dagger/sdk-helpers@main", refPin: self.gitCommit)
    let manifest = sdkHelpers.moduleManifest().withName("check").withLegacyGoRuntime
      .withLegacyRuntimeDependency(module)
    let unlocked = manifest.generate(self.workspace)
    self.assertNoPins(unlocked)
    self.assertContains(unlocked.file("dagger-module.toml").contents, "source = " + JSON.encode(module.asString))
    self.assertContains(unlocked.file("dagger.json").contents, "\"name\": " + JSON.encode(module.moduleOriginalName))
    let locked = manifest.generate(self.workspace, lock: true)
    self.assertContains(locked.file("dagger-module.toml").contents, "pin = " + JSON.encode(self.gitCommit))
    self.assertContains(locked.file("dagger.json").contents, "\"pin\": " + JSON.encode(self.gitCommit))
  }

  let gitCommit: String! = "64645f1967d3dba6fce951dd61ae4acd8d9b0861"

  let assertNoPins(ws: Workspace!): Void {
    self.assertAbsent(ws.file("dagger.json").contents, "\"pin\":")
    self.assertAbsent(ws.file("dagger-module.toml").contents, "pin =")
  }

  let assertContains(contents: String!, expected: String!): Void {
    if (!contents.contains(expected)) {
      raise "expected " + JSON.encode(expected) + " in:\n" + contents
    }
    null
  }

  let assertAbsent(contents: String!, unexpected: String!): Void {
    if (contents.contains(unexpected)) {
      raise "unexpected " + JSON.encode(unexpected) + " in:\n" + contents
    }
    null
  }

  let workspace: Workspace! {
    Dagger.directory.withNewFile("keep.txt", "keep").asWorkspace
  }

  let assertNoModuleSource(contents: String!): Void {
    if (contents.split("\n").contains("source = \".\"")) {
      raise "dagger-module.toml should omit the default module source:\n" + contents
    }
    null
  }
}

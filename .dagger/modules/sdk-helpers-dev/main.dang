"""Checks for the SDK helpers module."""
type SdkHelpersDev {
  """Check toml-contents."""
  testTomlContents(ws: Workspace!): Void @check {
    let manifest = sdkHelpers.moduleManifest
      .withName(name: "payments")
      .withDangEntrypoint(source: "./internal/dagger/main.dang")
      .withLegacyGoRuntime(moduleSource: "./src", engineVersion: "v0.20.3")
      .withLegacyInclude(path: "**/*.go")
      .withLegacyInclude(path: "go.mod")
    self.checkFiles(ws, "toml-contents", manifest.directory, manifest.tomlFile, manifest.legacyJSONFile)
    null
  }

  """Check json-contents."""
  testJsonContents(ws: Workspace!): Void @check {
    let manifest = sdkHelpers.moduleManifest
      .withName(name: "payments")
      .withModuleEntrypoint(source: "./entrypoint")
      .withLegacyPythonRuntime(moduleSource: "./src", engineVersion: "v0.20.3")
      .withLegacyInclude(path: "src/**")
    self.checkFiles(ws, "json-contents", manifest.directory, manifest.tomlFile, manifest.legacyJSONFile)
    null
  }


  """Check target-v1.2.3-v1.2.2."""
  testTargetV123V122(ws: Workspace!): Void @check {
    let message = {
      sdkHelpers.moduleManifest
        .withName(name: "payments")
        .withLegacyGoRuntime(moduleSource: "", engineVersion: "v1.2.3")
        .validate(targetEngineVersion: "v1.2.2")
      ""
    } rescue { error: Error => error.message }
    assert { message.contains(self.engineVersion("module manifest legacy runtime requires dagger v1.2.3, but target engine is v1.2.2")) }
    null
  }


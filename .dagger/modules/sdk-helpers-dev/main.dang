  """Keep builder branches independent."""
  testImmutableBranches(ws: Workspace!): Void @check {
    let base = sdkHelpers.moduleManifest
      .withName("base")
      .withDangEntrypoint("./main.dang")
    let left = base.withName("left").withLegacyGoRuntime(engineVersion: "v0.21.9")
    let right = base.withName("right").withModuleEntrypoint("./module")
    assert { base.tomlFile.contents == "name = \"base\"\n\n[entrypoint]\n  kind = \"dang\"\n  source = \"./main.dang\"\n" }
    assert { left.tomlFile.contents.contains("name = \"left\"\n") }
    assert { left.directory.entries.length == 2 }
    assert { right.tomlFile.contents == "name = \"right\"\n\n[entrypoint]\n  kind = \"module\"\n  source = \"./module\"\n" }
    assert { right.directory.entries.length == 1 }
    assert { base.directory.entries.length == 1 }
    null
  }

  """Match manifest field names by case."""
  testCaseSensitiveFields(ws: Workspace!): Void @check {
    let manifest = sdkHelpers.moduleManifest(loadJson: Dagger.file("dagger.json",
      "{\"name\":\"case\",\"sdk\":\"go\",\"engineVersion\":\"v0.21.9\",\"Include\":[\"wrong/**\"],\"include\":[\"right/**\"]}"
    ))
    let contents = manifest.legacyJSONFile.contents
    assert { contents.contains("right/**") }
    assert { !contents.contains("wrong/**") }
    null
  }


  """Keep input order for equal dependency keys."""
  testStableDependencyTies(ws: Workspace!): Void @check {
    let manifest = sdkHelpers.moduleManifest(
      loadJson: ws.file("/.dagger/modules/sdk-helpers-dev/testdata/tied-dependencies.json"),
    ).withLegacyRuntimeDependency(name: "z", source: "new")
    let dependencies = Dagger.json.withContents(manifest.legacyJSONFile.contents :: Dagger.JSON!)
      .field(["dependencies"]).asArray.{{contents}}
    assert {
      dependencies.map { dependency => Dagger.json.withContents(dependency.contents).field(["source"]).asString } ==
        ["a", "named-a", "named-b", "b", "named-c", "c", "named-d", "d", "named-e", "e", "f", "named-f", "new"]
    }
    null
  }

  """Sort 100 loaded dependencies when adding a dependency."""
  testManyDependencies(ws: Workspace!): Void @check {
    let input = ws.file("/.dagger/modules/sdk-helpers-dev/testdata/many-dependencies.json")
    let before = Dagger.json.withContents(input.contents :: Dagger.JSON!)
      .field(["dependencies"]).asArray.{{contents}}.map { dependency => Dagger.json.withContents(dependency.contents).field(["source"]).asString }
    let manifest = sdkHelpers.moduleManifest(loadJson: input)
      .withLegacyRuntimeDependency(name: "added", source: "./added")
    let dependencies = Dagger.json.withContents(manifest.legacyJSONFile.contents :: Dagger.JSON!)
      .field(["dependencies"]).asArray.{{contents}}
    let names = dependencies.map { dependency => Dagger.json.withContents(dependency.contents).field(["name"]).asString }
    let sources = dependencies.map { dependency => Dagger.json.withContents(dependency.contents).field(["source"]).asString }
    assert { names.length == 101 }
    assert { names[0] == "added" }
    assert { sources.contains("./added") }
    before.map { source =>
      assert { sources.contains(source) }
      null
    }
    names.dropFirst(1).map { name, index =>
      assert { (names[index] ?? "") <= name }
      null
    }
    null
  }

  """Keep helper state private and preserve the public API."""
  testPublicApi(ws: Workspace!): Void @check {
    let dependency = Dagger.currentModule.dependencies.{{id}}[0]
    if (dependency == null) {
      raise "sdk-helpers dependency is missing"
    } else {
      let module = Dagger.loadModuleFromID(toString(dependency.id) :: Dagger.ModuleID!)
      assert { module.name == "sdk-helpers" }
      assert { module.objects.{{id}}.length == 2 }
      module.objects.{{id}}.map { typeDef =>
        let object = Dagger.loadTypeDefFromID(toString(typeDef.id) :: Dagger.TypeDefID!).asObject
        if (object == null) {
          raise "expected an object type"
        } else {
          assert { object.fields.{{name}}.length == 0 }
          let names = object.functions.{{name}}.map { function => function.name }
          if (object.name == "SdkHelpers") {
            assert { names == ["moduleManifest"] }
            let function = object.functions.{{id}}[0]
            if (function == null) {
              raise "moduleManifest is missing"
            } else {
              let constructor = Dagger.loadFunctionFromID(toString(function.id) :: Dagger.FunctionID!)
              assert { constructor.args.{{name}}.map { arg => arg.name } == ["loadToml", "loadJson"] }
              constructor.args.{{id}}.map { arg =>
                assert { Dagger.loadFunctionArgFromID(toString(arg.id) :: Dagger.FunctionArgID!).typeDef.optional }
                null
              }
            }
          } else {
            assert { object.name == "SdkHelpersModuleManifest" }
            let expected = [
              "withName", "withLegacyRuntimeDependency",
              "withoutLegacyRuntimeDependency", "withoutLegacyRuntimeDependencies",
              "withDangEntrypoint", "withModuleEntrypoint",
              "withLegacyGoRuntime", "withLegacyDangRuntime",
              "withLegacyPythonRuntime", "withLegacyTypescriptRuntime",
              "withLegacyPHPRuntime", "withLegacyElixirRuntime", "withLegacyJavaRuntime",
              "withLegacyInclude", "withoutLegacyFields",
              "validate", "tomlFile", "legacyJSONFile", "directory",
            ]
            assert { names.length == expected.length }
            expected.map { name =>
              assert { names.contains(name) }
              null
            }
          }
        }
        null
      }
    }
    null
  }

  # Expected contents come from the Go builder. Do not derive them from the module.
  let checkFiles(ws: Workspace!, caseName: String!, directory: Directory!, toml: File!, json: File): Void {
    let expected = Dagger.json.withContents(
      ws.file("/.dagger/modules/sdk-helpers-dev/expected.json").contents :: Dagger.JSON!
    ).field([caseName])
    let names = expected.fields
    assert { directory.entries.length == names.length }
    names.map { name =>
      assert { directory.entries.contains(name) }
      let file = directory.file(name)
      let contents = self.engineVersion(expected.field([name]).asString)
      assert { file.name == name }
      assert { file.contents == contents }
      let stat = file.stat
      if (stat == null) {
        raise "file status is missing"
      } else {
        assert { stat.permissions == 420 }
      }
      null
    }
    assert { toml.name == "dagger-module.toml" }
    assert { toml.contents == self.engineVersion(expected.field(["dagger-module.toml"]).asString) }
    if (json != null) {
      assert { json.name == "dagger.json" }
      assert { json.contents == self.engineVersion(expected.field(["dagger.json"]).asString) }
    }
    null
  }

  let engineVersion(value: String!): String! {
    value.replace("${ENGINE_VERSION}", Dagger.version.split("+")[0] ?? Dagger.version)
  }
}
